{
  "expo": {
    "name": "Apex UGR",
    "slug": "apex-ugr",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexugr.app"
    },
    "android": {
      "package": "com.apexugr.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Apex UGR needs access to your GPS location for real-time driver radar, telemetry logging, and car meet navigation."
        }
      ]
    ]
  }
}
