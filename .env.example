# ============================================================
# Apex UGR — Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# --- CLOUDFLARE PAGES FUNCTIONS ---
# Leave blank for the same domain. Native development can point to the deployed API.
EXPO_PUBLIC_API_BASE_URL=

# --- eBay Motors API (server-only Cloudflare secrets) ---
# Add these to the Cloudflare Pages production environment after eBay approval.
# Never expose these with EXPO_PUBLIC_ prefixes.

# --- NHTSA Vehicle API (Free, no key needed) ---
# Used for VIN decoding and fitment data
# Base URL: https://vpic.nhtsa.dot.gov/api/

# --- Stripe (Phase 4: Payments) ---
# Get from: https://dashboard.stripe.com
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY

# --- Expo Push Notifications (Phase 9) ---
# Configured automatically via expo-notifications
